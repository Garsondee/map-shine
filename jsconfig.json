{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,

    // These settings will stop the implicit 'any' errors inside your module.js
    "noImplicitAny": false
  },
  "include": [
    "scripts/**/*.js",
    "eslint.config.js", // This line is crucial for fixing the config file errors
  ],
  "exclude": ["node_modules", "dist"]
}
